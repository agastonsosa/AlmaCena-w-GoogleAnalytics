{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "npm ci && npm run build",
  "functions": { "app.py": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/passwordrecovery", "destination": "/index.html" },
    { "source": "/passwordreset/:token", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
