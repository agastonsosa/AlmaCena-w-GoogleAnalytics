# Local backend. Copy to .env and run flask db upgrade.
FLASK_APP=src/app.py
FLASK_DEBUG=1
DATABASE_URL=sqlite:///almacena-local.sqlite
# Required in production; generate a random secret, never commit its value.
JWT_SECRET_KEY=
FRONTEND_URL=http://127.0.0.1:3000
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ENABLE_DEMO=true
# Use shared persistent storage before deploying multiple workers.
RATELIMIT_STORAGE_URI=memory://
# Optional image uploads; without this, recipes work without photos.
CLOUDINARY_URL=
# Optional password recovery; no emails are sent until configured.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Public GA4 ID and exact production hostnames (no protocol or path).
# Empty configuration disables analytics, including localhost and previews.
GA4_MEASUREMENT_ID=
GA4_ALLOWED_HOSTS=
# Vercel daily cleanup authorization; generate separately from the JWT secret.
CRON_SECRET=
# On Vercel use RATELIMIT_STORAGE_URI=almacena:// (shared PostgreSQL counters).
